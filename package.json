{
  "name": "@bitbaum/searchkit",
  "version": "0.2.2",
  "description": "Search that finds what was meant: typo budgets by word length, prefix while typing, German spellings without umlauts, joined and split words, Algolia-order tie-break ranking, highlight ranges, query expansion for any database, and a generated typo regression suite. Zero dependencies; React optional.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/searchkit.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "verify": "npm run type-check && npm run build && npm test"
  },
  "homepage": "https://github.com/bitbaum/searchkit#readme",
  "bugs": {
    "url": "https://github.com/bitbaum/searchkit/issues"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/react": "^19.3.0"
  }
}
